---
interface Props {
  id: string;
}
const { id } = Astro.props;
---
<h2 id={id} class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-500 dark:text-zinc-400">
  <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true"></span>
  <slot />
</h2>
