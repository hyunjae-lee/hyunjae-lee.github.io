---
/**
 * Home page (resume). Section order is built for a reader with 30 seconds:
 *   hero → about → selected work → experience →
 *   now building → recent writing → skills → credentials → publications/honors →
 *   education → contact.
 * Every section is a labelled landmark (aria-labelledby → its <h2>).
 */
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';
import SectionTitle from './SectionTitle.astro';
import { site, links, resume, avatar } from '../config';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const r = resume[lang];

// Selected work: the three most recent featured projects.
const collection = lang === 'ko' ? 'projectsKo' : 'projects';
const featured = (await getCollection(collection))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Recent writing: posts in any language, linked to the locale they were written in.
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' });

const publications = r.publications ?? [];
const training = r.training ?? [];

// One-page PDFs generated by `npm run resume` (scripts/gen-resume.mjs).
const resumeFiles = [
  { label: 'resume.pdfKo', href: '/resume/hyunjae-lee-resume-ko.pdf', download: '이현재_이력서.pdf', hreflang: 'ko' },
  { label: 'resume.pdfEn', href: '/resume/hyunjae-lee-resume-en.pdf', download: 'Hyunjae_Lee_Resume.pdf', hreflang: 'en' },
];
// Put the visitor's language first.
if (lang === 'en') resumeFiles.reverse();

const iconLink =
  'inline-flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-600 transition-colors hover:border-accent-500/60 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent-400';
const bullets =
  'list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-zinc-600 marker:text-accent-500 dark:text-zinc-400';
---
<!-- Hero -->
<section aria-labelledby="hero-name" class="relative py-6 sm:py-8">
  <div class="pointer-events-none absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -right-20 -top-24 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl dark:bg-accent-500/15"></div>
  </div>

  <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
    <div class="max-w-xl">
      <p class="text-sm font-medium text-accent-600 dark:text-accent-400">{r.role}</p>
      <h1 id="hero-name" class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
        {site.name}
        <span class="ml-1 text-2xl font-normal text-zinc-400 sm:text-3xl dark:text-zinc-600" lang="ko">{site.nameKo}</span>
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">{r.tagline}</p>

      <p class="mt-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-zinc-500 dark:text-zinc-400">
        <span class="inline-flex items-center gap-1.5">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
          {r.available}
        </span>
        <span>{r.location}</span>
      </p>

      <div class="no-print mt-7 flex flex-wrap items-center gap-2">
        {
          resumeFiles.map((f, i) => (
            <a
              href={f.href}
              download={f.download}
              hreflang={f.hreflang}
              type="application/pdf"
              class:list={[
                'inline-flex h-10 items-center gap-1.5 rounded-lg px-3.5 text-sm font-medium transition-colors',
                i === 0
                  ? 'bg-accent-600 text-white hover:bg-accent-700'
                  : 'border border-zinc-200 text-zinc-700 hover:border-accent-500/60 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-300 dark:hover:text-accent-400',
              ]}
            >
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11m0 0-4-4m4 4 4-4M5 19h14"></path></svg>
              {t(lang, f.label)}
              <span class="visually-hidden">(PDF)</span>
            </a>
          ))
        }
        <span class="mx-1 hidden h-6 w-px bg-zinc-200 sm:block dark:bg-zinc-800" aria-hidden="true"></span>
        <a href={links.email} class={iconLink}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          <span class="visually-hidden">Email</span>
        </a>
        <a href={links.github} target="_blank" rel="me noopener" class={iconLink}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.1 2.92.85.09-.66.35-1.1.63-1.36-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path></svg>
          <span class="visually-hidden">GitHub</span>
        </a>
        <a href={links.linkedin} target="_blank" rel="me noopener" class={iconLink}>
          <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"></path></svg>
          <span class="visually-hidden">LinkedIn</span>
        </a>
      </div>
    </div>

    <img
      src={avatar}
      alt={`${site.name} — profile photo`}
      width="176"
      height="176"
      fetchpriority="high"
      decoding="async"
      class="h-32 w-32 shrink-0 rounded-full border border-zinc-200 object-cover shadow-sm ring-2 ring-accent-500/25 ring-offset-4 ring-offset-white sm:h-44 sm:w-44 dark:border-zinc-800 dark:ring-offset-zinc-950"
    />
  </div>
</section>

<!-- About -->
<section aria-labelledby="sec-about" class="mt-14">
  <SectionTitle id="sec-about">{t(lang, 'section.about')}</SectionTitle>
  <p class="mt-6 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400" set:html={r.summary} />
</section>

<!-- Selected work -->
{
  featured.length > 0 && (
    <section aria-labelledby="sec-work" class="mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <SectionTitle id="sec-work">{t(lang, 'section.selected')}</SectionTitle>
        <a href={localizePath('/projects/', lang)} class="text-sm text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
          {t(lang, 'section.allProjects')}
        </a>
      </div>
      <div class="selected-grid mt-8 grid gap-4 sm:grid-cols-2">
        {featured.map((p) => (
          <ProjectCard
            title={p.data.title}
            description={p.data.description}
            tags={p.data.tags}
            date={p.data.date}
            status={p.data.status}
            lang={lang}
            href={localizePath(`/projects/${p.id}/`, lang)}
          />
        ))}
      </div>
    </section>
  )
}

<!-- Experience -->
<section aria-labelledby="sec-experience" class="mt-16">
  <SectionTitle id="sec-experience">{t(lang, 'section.experience')}</SectionTitle>
  <ol class="mt-8 space-y-10">
    {
      r.experience.map((job) => (
        <li class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-6">
          <div class="text-sm text-zinc-500 dark:text-zinc-400">
            <p>{job.period}</p>
            {job.location && <p class="mt-0.5 text-xs">{job.location}</p>}
          </div>
          <article>
            <h3 class="font-medium text-zinc-900 dark:text-zinc-100">
              {job.role} <span class="text-zinc-500 dark:text-zinc-400">· {job.org}</span>
            </h3>
            {job.points && (
              <ul class:list={['mt-2', bullets]}>
                {job.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            {job.phases && (
              <div class="mt-3 space-y-5">
                {job.phases.map((phase) => (
                  <section class="border-l-2 border-zinc-100 pl-4 dark:border-zinc-800">
                    <p class="text-xs font-medium text-accent-600 dark:text-accent-400">{phase.period}</p>
                    <h4 class="mt-0.5 text-sm font-medium text-zinc-700 dark:text-zinc-300">{phase.focus}</h4>
                    <ul class:list={['mt-2', bullets]}>
                      {phase.points.map((p) => (
                        <li>{p}</li>
                      ))}
                    </ul>
                  </section>
                ))}
              </div>
            )}
          </article>
        </li>
      ))
    }
  </ol>
</section>

<!-- Now building -->
{
  r.now && r.now.length > 0 && (
    <section aria-labelledby="sec-now" class="mt-16">
      <SectionTitle id="sec-now">{t(lang, 'section.now')}</SectionTitle>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {r.now.map((n) => (
          <li class="rounded-xl border border-dashed border-zinc-200 p-5 dark:border-zinc-800">
            <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{n.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{n.text}</p>
          </li>
        ))}
      </ul>
    </section>
  )
}

<!-- Recent writing -->
{
  posts.length > 0 && (
    <section aria-labelledby="sec-writing" class="no-print mt-16">
      <div class="flex items-baseline justify-between gap-4">
        <SectionTitle id="sec-writing">{t(lang, 'section.writing')}</SectionTitle>
        <a href={localizePath('/blog/', lang)} class="text-sm text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
          {t(lang, 'section.allPosts')}
        </a>
      </div>
      <ol class="mt-6 divide-y divide-zinc-100 dark:divide-zinc-900">
        {posts.map((p) => (
          <li class="py-4">
            <a href={localizePath(`/blog/${p.id}/`, p.data.lang)} hreflang={p.data.lang} class="group grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6">
              <time datetime={p.data.pubDate.toISOString()} class="text-sm text-zinc-500 dark:text-zinc-400">
                {fmtDate(p.data.pubDate)}
              </time>
              <span class="font-medium text-zinc-900 transition-colors group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400" lang={p.data.lang}>
                {p.data.title}
              </span>
            </a>
          </li>
        ))}
      </ol>
    </section>
  )
}

<!-- Skills -->
<section aria-labelledby="sec-skills" class="mt-16">
  <SectionTitle id="sec-skills">{t(lang, 'section.skills')}</SectionTitle>
  <dl class="mt-8 grid gap-6 sm:grid-cols-2">
    {
      r.skills.map((s) => (
        <div>
          <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{s.group}</dt>
          <dd class="mt-2">
            <ul class="flex flex-wrap gap-2">
              {s.items.map((item) => (
                <li class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
  </dl>
</section>

<!-- Credentials: certifications, training, languages -->
<section aria-labelledby="sec-credentials" class="mt-16">
  <SectionTitle id="sec-credentials">{t(lang, 'section.credentials')}</SectionTitle>
  <div class="mt-8 grid gap-10 sm:grid-cols-2">
    <div>
      <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{t(lang, 'section.certifications')}</h3>
      <ul class="mt-3 space-y-3">
        {
          r.certifications.map((c) => (
            <li>
              <p class="text-sm text-zinc-800 dark:text-zinc-200">{c.name}</p>
              {(c.issuer || c.date || c.note) && (
                <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{[c.issuer, c.date, c.note].filter(Boolean).join(' · ')}</p>
              )}
            </li>
          ))
        }
      </ul>

      <h3 class="mt-8 text-sm font-medium text-zinc-900 dark:text-zinc-100">{t(lang, 'section.languages')}</h3>
      <dl class="mt-3 space-y-2">
        {
          r.languages.map((l) => (
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm text-zinc-800 dark:text-zinc-200">{l.name}</dt>
              <dd class="flex items-center gap-2 text-right text-sm text-zinc-500 dark:text-zinc-400">
                <span>{l.level}</span>
                {l.badge && (
                  <span class="rounded-full bg-accent-500/10 px-2 py-0.5 text-xs font-semibold text-accent-600 dark:text-accent-400">{l.badge}</span>
                )}
              </dd>
            </div>
          ))
        }
      </dl>
    </div>

    {
      training.length > 0 && (
        <div>
          <h3 class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{t(lang, 'section.training')}</h3>
          <ul class="mt-3 space-y-3">
            {training.map((tr) => (
              <li>
                <p class="text-sm text-zinc-800 dark:text-zinc-200">{tr.name}</p>
                <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{[tr.issuer, tr.date, tr.hours].filter(Boolean).join(' · ')}</p>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<!-- Publications & honors -->
<section aria-labelledby="sec-recognition" class="mt-16 grid gap-10 sm:grid-cols-2">
  {
    publications.length > 0 && (
      <div>
        <SectionTitle id="sec-recognition">{t(lang, 'section.publications')}</SectionTitle>
        <ul class="mt-8 space-y-5">
          {publications.map((pub) => (
            <li>
              <p class="text-xs font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400">{pub.type}</p>
              <p class="mt-1 text-sm font-medium text-zinc-900 dark:text-zinc-100">
                {pub.link ? (
                  <a href={pub.link} target="_blank" rel="noopener" class="hover:text-accent-600 dark:hover:text-accent-400">
                    {pub.title} ↗
                  </a>
                ) : (
                  pub.title
                )}
              </p>
              {pub.venue && <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{pub.venue}</p>}
            </li>
          ))}
        </ul>
      </div>
    )
  }

  {
    r.honors.length > 0 && (
      <div>
        <SectionTitle id="sec-honors">{t(lang, 'section.honors')}</SectionTitle>
        <ul class="mt-8 space-y-4">
          {r.honors.map((h) => (
            <li class="text-sm text-zinc-700 dark:text-zinc-300">
              <p>{h.text}</p>
              {(h.image || h.project) && (
                <p class="no-print mt-1 flex flex-wrap gap-x-4 gap-y-1">
                  {h.image && (
                    <button
                      type="button"
                      class="text-xs font-medium text-accent-600 underline-offset-2 hover:underline dark:text-accent-400"
                      data-image-dialog={h.image}
                      data-caption={h.text}
                      data-mode="fit"
                    >
                      {t(lang, 'action.viewCertificate')}
                    </button>
                  )}
                  {h.project && (
                    <a
                      href={localizePath(`/projects/${h.project}/`, lang)}
                      class="text-xs font-medium text-accent-600 underline-offset-2 hover:underline dark:text-accent-400"
                    >
                      {t(lang, 'action.viewProject')}
                    </a>
                  )}
                </p>
              )}
            </li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<!-- Education -->
<section aria-labelledby="sec-education" class="mt-16">
  <SectionTitle id="sec-education">{t(lang, 'section.education')}</SectionTitle>
  <ul class="mt-8 space-y-4">
    {
      r.education.map((e) => (
        <li class="grid gap-1 sm:grid-cols-[9rem_1fr] sm:gap-6">
          <p class="text-sm text-zinc-500 dark:text-zinc-400">{e.period}</p>
          <p class="text-sm text-zinc-700 dark:text-zinc-300">
            <span class="font-medium text-zinc-900 dark:text-zinc-100">{e.title}</span> ·{' '}
            {e.link ? (
              <a href={e.link} target="_blank" rel="noopener" class="text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
                {e.org} ↗
              </a>
            ) : (
              e.org
            )}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<!-- Contact -->
<section aria-labelledby="sec-contact" class="mt-16 rounded-2xl border border-zinc-200 bg-gradient-to-br from-zinc-50 to-white p-8 dark:border-zinc-800 dark:from-zinc-900/50 dark:to-zinc-950">
  <h2 id="sec-contact" class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">{t(lang, 'contact.title')}</h2>
  <p class="mt-2 max-w-xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{t(lang, 'contact.blurb')}</p>
  <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
    <a href={links.email} class="font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
      {links.email.replace('mailto:', '')}
    </a>
    <a href={links.linkedin} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">LinkedIn ↗</a>
    <a href={links.github} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">GitHub ↗</a>
  </div>
</section>

<style>
  /* With three selected projects, the newest spans the full row; the card's own
     container query then gives it the roomier layout. */
  @media (width >= 40rem) {
    .selected-grid > :global(:first-child:nth-last-child(odd)) {
      grid-column: 1 / -1;
    }
  }
</style>
