---
import { render } from 'astro:content';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  project: any;
  lang: Lang;
  kind?: 'project' | 'post'; // blog posts reuse this layout
}
const { project, lang, kind = 'project' } = Astro.props;
const { Content } = await render(project);
const { title, description, tags = [], link, repo, status } = project.data;
const date = project.data.date ?? project.data.pubDate;
const isPost = kind === 'post';
const backHref = localizePath(isPost ? '/blog/' : '/projects/', lang);
const backLabel = t(lang, isPost ? 'action.backToBlog' : 'action.backToProjects');
const related = isPost ? project.data.project : undefined;
const dateLabel = new Date(date).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
  year: 'numeric',
  month: 'long',
  ...(isPost ? { day: 'numeric' } : {}),
});
const inProgress = status === 'in-progress';
---
<article>
  <a href={backHref} class="text-sm text-zinc-500 transition-colors hover:text-accent-600 dark:hover:text-accent-400">
    {backLabel}
  </a>

  <header class="mt-6 border-b border-zinc-100 pb-8 dark:border-zinc-900">
    <div class="flex items-center gap-3">
      <p class="text-sm text-zinc-400">{dateLabel}</p>
      {inProgress && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-accent-500/10 px-2.5 py-0.5 text-xs font-semibold text-accent-600 dark:text-accent-400">
          <span class="relative flex h-1.5 w-1.5">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-500 opacity-75" />
            <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent-500" />
          </span>
          {t(lang, 'label.inProgress')}
        </span>
      )}
    </div>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{title}</h1>
    <p class="mt-3 max-w-2xl leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>

    {
      tags.length > 0 && (
        <ul class="mt-5 flex flex-wrap gap-2">
          {tags.map((tag: string) => (
            <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
              {tag}
            </li>
          ))}
        </ul>
      )
    }

    {
      (link || repo || related) && (
        <div class="mt-5 flex flex-wrap gap-4 text-sm">
          {related && (
            <a href={localizePath(`/projects/${related}/`, lang)} class="font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
              {t(lang, 'action.relatedProject')}
            </a>
          )}
          {link && (
            <a href={link} target="_blank" rel="noopener" class="font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
              {t(lang, 'label.live')}
            </a>
          )}
          {repo && (
            <a href={repo} target="_blank" rel="noopener" class="font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
              {t(lang, 'label.source')}
            </a>
          )}
        </div>
      )
    }
  </header>

  <div class="prose mt-8">
    <Content />
  </div>
</article>

<style>
  /* Colors use light-dark(), which follows the page's color-scheme
     (synced from <meta name="color-scheme"> in global.css). */
  .prose {
    --prose-text: light-dark(var(--color-zinc-700), var(--color-zinc-300));
    --prose-strong: light-dark(var(--color-zinc-900), var(--color-zinc-100));
    --prose-muted: var(--color-zinc-500);
    --prose-line: light-dark(var(--color-zinc-200), var(--color-zinc-800));
    --prose-surface: light-dark(var(--color-zinc-50), var(--color-zinc-900));
    --prose-code: light-dark(var(--color-zinc-100), var(--color-zinc-900));
    --prose-link: light-dark(var(--color-accent-600), var(--color-accent-400));

    color: var(--prose-text);
    line-height: 1.75;
  }
  .prose :global(h2) {
    margin-top: 2.25rem;
    margin-bottom: 0.75rem;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--prose-strong);
    scroll-margin-top: 5rem;
  }
  .prose :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--prose-strong);
  }
  .prose :global(strong) {
    color: var(--prose-strong);
  }
  .prose :global(p) {
    margin-block: 1rem;
  }
  .prose :global(ul),
  .prose :global(ol) {
    margin: 1rem 0;
    padding-left: 1.25rem;
  }
  .prose :global(ul) {
    list-style: disc;
  }
  .prose :global(ol) {
    list-style: decimal;
  }
  .prose :global(li) {
    margin: 0.375rem 0;
  }
  .prose :global(li)::marker {
    color: var(--color-accent-500);
  }
  .prose :global(a) {
    color: var(--prose-link);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose :global(blockquote) {
    margin: 1.25rem 0;
    border-left: 3px solid var(--color-accent-500);
    padding-left: 1rem;
    color: var(--prose-muted);
  }
  .prose :global(code) {
    border-radius: 0.25rem;
    background: var(--prose-code);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
  }
  .prose :global(pre) {
    margin-block: 1.25rem;
    overflow-x: auto;
    border-radius: 0.5rem;
    background: var(--prose-code);
    padding: 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
  }
  .prose :global(pre code) {
    background: none;
    padding: 0;
  }
  .prose :global(img) {
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--prose-line);
    cursor: zoom-in;
  }
  .prose :global(.table-wrapper) {
    border: 1px solid var(--prose-line);
  }
  .prose :global(table) {
    inline-size: max-content;
    min-inline-size: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .prose :global(th),
  .prose :global(td) {
    border-block-end: 1px solid var(--prose-line);
    padding: 0.5rem 0.75rem;
    text-align: start;
    vertical-align: top;
    max-inline-size: 28rem;
  }
  .prose :global(tr:last-child td) {
    border-block-end: 0;
  }
  .prose :global(th) {
    background: var(--prose-surface);
    font-weight: 600;
    color: var(--prose-strong);
    white-space: nowrap;
  }
  .prose :global(td:first-child) {
    white-space: nowrap;
  }
</style>
