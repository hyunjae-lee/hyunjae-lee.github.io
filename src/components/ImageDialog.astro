---
/**
 * One modal image viewer for the whole site, built on native <dialog closedby="any">
 * (modern-web-guidance: light-dismiss-a-dialog). Esc, backdrop click/tap, and the
 * close button all dismiss it; focus is trapped by showModal().
 *
 * Open it from any element with `data-image-dialog="<src>"` (optional
 * `data-caption`, and `data-mode="pan"` for large diagrams that should open at full
 * size and scroll), or automatically from images inside `.prose`.
 */
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---
<dialog id="image-dialog" class="image-dialog no-print" closedby="any" aria-label={t(lang, 'dialog.image')}>
  <form method="dialog" class="absolute right-2 top-2 z-10">
    <button
      type="submit"
      class="inline-flex h-11 w-11 items-center justify-center rounded-lg bg-black/50 text-white/90 transition-colors hover:bg-black/70 hover:text-white"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
      <span class="visually-hidden">{t(lang, 'dialog.close')}</span>
    </button>
  </form>
  <figure class="flex h-full flex-col items-center">
    <div class="image-dialog-scroll grid h-full w-full place-items-center overflow-auto">
      <img src="" alt="" class="rounded-lg bg-white shadow-2xl" />
    </div>
    <figcaption class="mt-3 text-center text-sm text-white/80 empty:hidden"></figcaption>
  </figure>
</dialog>

<style>
  dialog:not([data-mode='pan']) img {
    max-inline-size: 100%;
    max-block-size: calc(100dvh - 6rem);
    inline-size: auto;
  }
  dialog[data-mode='pan'] img {
    max-inline-size: none;
  }
</style>

<script>
  const dialog = document.getElementById('image-dialog') as HTMLDialogElement | null;
  if (dialog) {
    const img = dialog.querySelector('img')!;
    const caption = dialog.querySelector('figcaption')!;
    const scroller = dialog.querySelector<HTMLElement>('.image-dialog-scroll')!;

    const open = (src: string, alt: string, text: string, mode: string) => {
      img.src = src;
      img.alt = alt;
      caption.textContent = text;
      dialog.dataset.mode = mode;
      dialog.showModal();
      scroller.scrollTo(0, 0);
    };

    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
    });

    // Fallback light-dismiss where <dialog closedby> isn't supported (Safari).
    if (!('closedBy' in HTMLDialogElement.prototype)) {
      dialog.addEventListener('click', (event) => {
        // Backdrop clicks target the <dialog> itself, outside its box.
        if (event.target !== dialog) return;
        const r = dialog.getBoundingClientRect();
        const inside = r.top <= event.clientY && event.clientY <= r.bottom && r.left <= event.clientX && event.clientX <= r.right;
        if (!inside) dialog.close();
      });
    }

    document.querySelectorAll<HTMLElement>('[data-image-dialog]').forEach((el) => {
      el.addEventListener('click', () =>
        open(el.dataset.imageDialog!, el.dataset.caption ?? '', el.dataset.caption ?? '', el.dataset.mode ?? 'fit')
      );
    });

    // Diagrams and screenshots inside articles open at full size for panning.
    document.querySelectorAll<HTMLImageElement>('.prose img').forEach((im) => {
      im.tabIndex = 0;
      im.setAttribute('role', 'button');
      const go = () => open(im.currentSrc || im.src, im.alt, im.alt, 'pan');
      im.addEventListener('click', go);
      im.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          go();
        }
      });
    });
  }
</script>
