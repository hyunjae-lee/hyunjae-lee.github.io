---
import ThemeToggle from './ThemeToggle.astro';
import { site, nav } from '../config';

// Normalize the current path so the active nav link is highlighted regardless
// of a trailing slash.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
---
<header class="sticky top-0 z-40 border-b border-zinc-100 bg-white/80 backdrop-blur dark:border-zinc-900 dark:bg-zinc-950/80">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      {site.name}
    </a>

    <nav class="flex items-center gap-1" aria-label="주요 메뉴">
      {
        nav.map((item) => {
          const href = item.href.replace(/\/+$/, '') || '/';
          const isActive = path === href;
          return (
            <a
              href={item.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm transition-colors',
                isActive
                  ? 'text-accent-600 dark:text-accent-400'
                  : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
      <span class="mx-1 h-5 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></span>
      <ThemeToggle />
    </nav>
  </div>
</header>
