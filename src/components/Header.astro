---
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../config';
import { navItems, t, localizePath, alternatePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Normalize the current path (drop locale prefix + trailing slash) for active state.
const rawPath = Astro.url.pathname.replace(/^\/ko(?=\/|$)/, '') || '/';
const path = rawPath.replace(/\/+$/, '') || '/';

const homeHref = localizePath('/', lang);
const altHref = alternatePath(Astro.url.pathname, lang);
---
<header class="sticky top-0 z-40 border-b border-zinc-100 bg-white/80 backdrop-blur dark:border-zinc-900 dark:bg-zinc-950/80">
  <div class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href={homeHref} class="text-sm font-semibold tracking-tight text-zinc-900 dark:text-zinc-100">
      {site.name}
    </a>

    <nav class="flex items-center gap-1" aria-label="Primary">
      {
        navItems.map((item) => {
          const target = item.path.replace(/\/+$/, '') || '/';
          const isActive = path === target;
          return (
            <a
              href={localizePath(item.path, lang)}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'rounded-md px-3 py-1.5 text-sm transition-colors',
                isActive
                  ? 'text-accent-600 dark:text-accent-400'
                  : 'text-zinc-600 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100',
              ]}
            >
              {t(lang, item.key)}
            </a>
          );
        })
      }
      <span class="mx-1 h-5 w-px bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></span>

      <!-- Language toggle -->
      <a
        href={altHref}
        aria-label={t(lang, 'a11y.langSwitch')}
        class="inline-flex h-9 items-center gap-1 rounded-md border border-zinc-200 px-2 text-xs font-semibold text-zinc-600 transition-colors hover:bg-zinc-100 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-900 dark:hover:text-zinc-100"
      >
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9"></circle>
          <path d="M3 12h18M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18"></path>
        </svg>
        {t(lang, 'lang.switchLabel')}
      </a>

      <ThemeToggle />
    </nav>
  </div>
</header>
