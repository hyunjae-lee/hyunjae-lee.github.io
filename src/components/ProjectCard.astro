---
/**
 * Project card (modern-web-guidance: card).
 * - <article> root; the heading holds the single primary link (`.card-link`), whose
 *   ::after stretches across the card so the whole card is clickable.
 * - Hover and keyboard focus are drawn on the card via :has(), not on the link.
 * - The card is its own size container, so its layout follows its width, not the viewport.
 */
import { t, type Lang } from '../i18n';
interface Props {
  title: string;
  description: string;
  tags?: string[];
  href: string; // detail page, e.g. /projects/my-project/
  date?: Date;
  status?: string; // 'in-progress' gets a distinct treatment
  lang?: Lang;
  headingLevel?: 'h2' | 'h3';
}
const { title, description, tags = [], href, date, status, lang = 'en', headingLevel = 'h3' } = Astro.props;
const year = date ? new Date(date).getFullYear() : undefined;
const inProgress = status === 'in-progress';
const Heading = headingLevel;
---
<article class:list={['card', { 'is-in-progress': inProgress }]}>
  <header>
    <p class="card-meta">
      {
        inProgress && (
          <span class="card-badge">
            <span class="card-dot" aria-hidden="true" />
            {t(lang, 'label.inProgress')}
          </span>
        )
      }
      {year && <span>{year}</span>}
    </p>
    <Heading class="card-title">
      <a class="card-link" href={href}>{title}</a>
    </Heading>
  </header>

  <p class="card-text">{description}</p>

  {
    tags.length > 0 && (
      <ul class="card-tags" aria-label={lang === 'ko' ? '태그' : 'Tags'}>
        {tags.slice(0, 6).map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )
  }
</article>

<style>
  .card {
    --card-line: light-dark(var(--color-zinc-200), var(--color-zinc-800));
    --card-text: light-dark(var(--color-zinc-600), var(--color-zinc-400));
    --card-title: light-dark(var(--color-zinc-900), var(--color-zinc-100));
    --card-chip: light-dark(var(--color-zinc-100), var(--color-zinc-900));

    container-type: inline-size;
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    border: 1px solid var(--card-line);
    border-radius: 0.75rem;
    padding: 1.5rem;
    transition:
      border-color 150ms,
      box-shadow 150ms,
      translate 150ms;

    &.is-in-progress {
      border-color: color-mix(in oklab, var(--color-accent-500) 45%, transparent);
      background: light-dark(
        color-mix(in oklab, var(--color-accent-50) 60%, transparent),
        color-mix(in oklab, var(--color-accent-500) 6%, transparent)
      );
    }

    &:has(a.card-link:hover) {
      border-color: color-mix(in oklab, var(--color-accent-500) 60%, transparent);
      box-shadow: 0 10px 30px -12px rgb(0 0 0 / 0.18);
      translate: 0 -2px;
    }
    &:has(a.card-link:focus-visible) {
      outline: 2px solid var(--color-accent-500);
      outline-offset: 2px;
    }
  }

  .card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-zinc-400);
  }
  .card-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    border-radius: 999px;
    background: color-mix(in oklab, var(--color-accent-500) 12%, transparent);
    padding: 0.125rem 0.625rem;
    font-weight: 600;
    color: light-dark(var(--color-accent-600), var(--color-accent-400));
  }
  .card-dot {
    inline-size: 0.375rem;
    block-size: 0.375rem;
    border-radius: 999px;
    background: var(--color-accent-500);
  }

  .card-title {
    margin-top: 0.375rem;
    font-weight: 600;
    line-height: 1.4;
    color: var(--card-title);
  }
  .card-link {
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
    }
    &:focus-visible {
      outline: none; /* drawn on the card instead */
    }
  }
  .card:has(a.card-link:hover) .card-title {
    color: light-dark(var(--color-accent-600), var(--color-accent-400));
  }

  .card-text {
    font-size: 0.875rem;
    line-height: 1.65;
    color: var(--card-text);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 4;
    line-clamp: 4;
    overflow: hidden;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    li {
      border-radius: 999px;
      background: var(--card-chip);
      padding: 0.125rem 0.625rem;
      font-size: 0.75rem;
      color: var(--card-text);
    }
  }

  /* Wide card (e.g. full-width in a single column): give the text more room. */
  @container (width > 34rem) {
    .card-text {
      -webkit-line-clamp: 3;
      line-clamp: 3;
      font-size: 0.9375rem;
    }
    .card-title {
      font-size: 1.125rem;
    }
  }
</style>
