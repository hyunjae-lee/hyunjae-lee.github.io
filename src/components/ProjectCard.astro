---
import { t, type Lang } from '../i18n';
interface Props {
  title: string;
  description: string;
  tags?: string[];
  href: string; // detail page, e.g. /projects/my-project/
  date?: Date;
  status?: string; // 'in-progress' gets a distinct treatment
  lang?: Lang;
}
const { title, description, tags = [], href, date, status, lang = 'en' } = Astro.props;
const year = date ? new Date(date).getFullYear() : undefined;
const inProgress = status === 'in-progress';
---
<article
  class:list={[
    'group relative rounded-xl border p-6 transition-all hover:-translate-y-0.5 hover:shadow-lg',
    inProgress
      ? 'border-accent-500/50 bg-accent-50/50 ring-1 ring-accent-500/20 hover:border-accent-500/70 hover:shadow-accent-500/10 dark:border-accent-400/40 dark:bg-accent-500/5 dark:ring-accent-400/15'
      : 'border-zinc-200 hover:border-accent-500/60 hover:shadow-zinc-900/5 dark:border-zinc-800 dark:hover:border-accent-400/60 dark:hover:shadow-black/20',
  ]}
>
  {
    inProgress && (
      <span class="mb-3 inline-flex items-center gap-1.5 rounded-full bg-accent-500/10 px-2.5 py-0.5 text-xs font-semibold text-accent-600 dark:text-accent-400">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent-500 opacity-75" />
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-accent-500" />
        </span>
        {t(lang, 'label.inProgress')}
      </span>
    )
  }

  <div class="flex items-start justify-between gap-4">
    <h3 class="font-medium text-zinc-900 dark:text-zinc-100">
      <a href={href} class="after:absolute after:inset-0">{title}</a>
    </h3>
    {year && <span class="shrink-0 text-xs text-zinc-400">{year}</span>}
  </div>

  <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
            {tag}
          </li>
        ))}
      </ul>
    )
  }

  <span class="mt-4 inline-block text-sm font-medium text-accent-600 transition-colors group-hover:text-accent-700 dark:text-accent-400" aria-hidden="true">
    {t(lang, 'action.readMore')}
  </span>
</article>
