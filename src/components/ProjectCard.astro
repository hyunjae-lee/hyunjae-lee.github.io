---
interface Props {
  title: string;
  titleEn?: string;
  description: string;
  tags?: string[];
  href?: string;
  year?: string;
}
const { title, titleEn, description, tags = [], href = '#', year } = Astro.props;
const external = href !== '#' && /^https?:/.test(href);
---
<article class="group relative rounded-xl border border-zinc-200 p-6 transition-colors hover:border-accent-500/60 dark:border-zinc-800 dark:hover:border-accent-400/60">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h3 class="font-medium text-zinc-900 dark:text-zinc-100">
        <a href={href} class="after:absolute after:inset-0" {...external ? { target: '_blank', rel: 'noopener' } : {}}>
          {title}
        </a>
      </h3>
      {titleEn && <p class="mt-0.5 text-sm text-zinc-500">{titleEn}</p>}
    </div>
    {year && <span class="shrink-0 text-xs text-zinc-400">{year}</span>}
  </div>

  <p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{description}</p>

  {
    tags.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">
            {tag}
          </li>
        ))}
      </ul>
    )
  }
</article>
