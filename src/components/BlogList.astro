---
import { getCollection } from 'astro:content';
import { t, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

// Every post is listed in both locales; each links to the locale it was written in.
const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString(lang === 'ko' ? 'ko-KR' : 'en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---
<section>
  <h1 class="text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">{t(lang, 'blog.title')}</h1>
  <p class="mt-4 max-w-xl leading-relaxed text-zinc-600 dark:text-zinc-400">{t(lang, 'blog.intro')}</p>
</section>

{
  posts.length > 0 ? (
    <ol class="mt-10 divide-y divide-zinc-100 dark:divide-zinc-900">
      {posts.map((p) => (
        <li class="group relative py-6">
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-zinc-400">
            <time datetime={p.data.pubDate.toISOString()}>{fmt(p.data.pubDate)}</time>
            {p.data.lang !== lang && (
              <span class="rounded-full bg-zinc-100 px-2 py-0.5 text-xs text-zinc-500 dark:bg-zinc-900 dark:text-zinc-400">
                {t(lang, 'blog.otherLang')}
              </span>
            )}
          </div>
          <h2 class="mt-1.5 font-medium text-zinc-900 transition-colors group-hover:text-accent-600 dark:text-zinc-100 dark:group-hover:text-accent-400">
            <a href={localizePath(`/blog/${p.id}/`, p.data.lang)} class="after:absolute after:inset-0">
              {p.data.title}
            </a>
          </h2>
          {p.data.description && (
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.data.description}</p>
          )}
          {p.data.tags.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {p.data.tags.map((tag) => (
                <li class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs text-zinc-600 dark:bg-zinc-900 dark:text-zinc-400">{tag}</li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ol>
  ) : (
    <p class="mt-10 text-zinc-500">{t(lang, 'blog.empty')}</p>
  )
}
