---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, links, resume, avatar } from '../config';

// Featured projects for the "Selected work" section (most recent first).
const featured = (await getCollection('projects'))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const publications = resume.publications ?? [];
---
<BaseLayout>
  <!-- Hero -->
  <section class="relative py-6 sm:py-8">
    <div
      class="pointer-events-none absolute -right-20 -top-24 -z-10 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl dark:bg-accent-500/15"
      aria-hidden="true"
    >
    </div>

    <div class="flex flex-col-reverse items-start gap-8 sm:flex-row sm:items-center sm:justify-between">
      <div class="max-w-xl">
        <p class="text-sm font-medium text-accent-600 dark:text-accent-400">{resume.role}</p>
        <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
          {site.name}
          <span class="ml-1 text-2xl font-normal text-zinc-400 dark:text-zinc-600 sm:text-3xl">{site.nameKo}</span>
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
          {site.tagline}
        </p>
        {site.bio && <p class="mt-2 text-sm italic text-zinc-400 dark:text-zinc-500">“{site.bio}”</p>}

        <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
          <span class="inline-flex items-center gap-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-emerald-500" aria-hidden="true"></span>
            {resume.available}
          </span>
          <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">·</span>
          <span>{resume.location}</span>
        </div>

        <!-- Contact icon links -->
        <div class="no-print mt-7 flex items-center gap-2">
          <a href={links.email} aria-label="Email" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-600 transition-colors hover:border-accent-500/60 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg>
          </a>
          <a href={links.github} target="_blank" rel="me noopener" aria-label="GitHub" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-600 transition-colors hover:border-accent-500/60 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.48v-1.7c-2.78.62-3.37-1.2-3.37-1.2-.46-1.18-1.11-1.5-1.11-1.5-.9-.63.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.1 2.92.85.09-.66.35-1.1.63-1.36-2.22-.26-4.56-1.14-4.56-5.05 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.7 0 0 .84-.28 2.75 1.05a9.36 9.36 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.4.2 2.44.1 2.7.64.72 1.03 1.63 1.03 2.75 0 3.92-2.34 4.79-4.57 5.04.36.32.68.94.68 1.9v2.82c0 .27.18.59.69.48A10.02 10.02 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path></svg>
          </a>
          <a href={links.linkedin} target="_blank" rel="me noopener" aria-label="LinkedIn" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-600 transition-colors hover:border-accent-500/60 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13ZM7.12 20.45H3.55V9h3.57v11.45ZM22.22 0H1.77C.8 0 0 .78 0 1.75v20.5C0 23.22.8 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.75V1.75C24 .78 23.2 0 22.22 0Z"></path></svg>
          </a>
          <a href={links.personal} target="_blank" rel="me noopener" aria-label="Personal notes" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-zinc-200 text-zinc-600 transition-colors hover:border-accent-500/60 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent-400">
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3v5h5"></path><path d="M18 21H6a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8l5 5v11a2 2 0 0 1-2 2Z"></path><path d="M9 13h6M9 17h4"></path></svg>
          </a>
        </div>
      </div>

      <!-- Avatar (from GitHub), circular with a subtle ring -->
      <img
        src={avatar}
        alt={`${site.name} — profile photo`}
        width="176"
        height="176"
        class="h-32 w-32 shrink-0 rounded-full border border-zinc-200 object-cover shadow-sm ring-2 ring-accent-500/25 ring-offset-4 ring-offset-white sm:h-44 sm:w-44 dark:border-zinc-800 dark:ring-offset-zinc-950"
      />
    </div>
  </section>

  <!-- Summary -->
  <section class="mt-14 border-t border-zinc-100 pt-12 dark:border-zinc-900">
    <p class="max-w-2xl text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
      {resume.summary}
    </p>
  </section>

  <!-- Experience -->
  <section class="mt-16">
    <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
      <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true"></span>
      Experience
    </h2>
    <ol class="mt-8 space-y-10">
      {
        resume.experience.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <div class="text-sm text-zinc-400">
              <p>{job.period}</p>
              {job.location && <p class="mt-0.5 text-xs">{job.location}</p>}
            </div>
            <div>
              <h3 class="font-medium text-zinc-900 dark:text-zinc-100">
                {job.role} <span class="text-zinc-400">· {job.org}</span>
              </h3>
              <ul class="mt-2 list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-zinc-600 marker:text-accent-500 dark:text-zinc-400">
                {job.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Selected work -->
  {
    featured.length > 0 && (
      <section class="mt-16">
        <div class="flex items-baseline justify-between">
          <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
            <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true" />
            Selected work
          </h2>
          <a href="/projects/" class="text-sm text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
            All projects →
          </a>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {featured.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              date={p.data.date}
              href={`/projects/${p.id}/`}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Skills -->
  <section class="mt-16">
    <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
      <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true"></span>
      Skills
    </h2>
    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        resume.skills.map((s) => (
          <div>
            <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{s.group}</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {s.items.map((item) => (
                <span class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-600 transition-colors hover:border-accent-500/50 hover:text-accent-600 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-accent-400">
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Languages & Certifications -->
  <section class="mt-16 grid gap-10 sm:grid-cols-2">
    <div>
      <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
        <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true"></span>
        Languages
      </h2>
      <dl class="mt-8 space-y-3">
        {
          resume.languages.map((l) => (
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{l.name}</dt>
              <dd class="text-right text-sm text-zinc-500 dark:text-zinc-400">{l.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
        <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true"></span>
        Certifications
      </h2>
      <ul class="mt-8 space-y-4">
        {
          resume.certifications.map((c) => (
            <li>
              <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{c.name}</p>
              {(c.issuer || c.date || c.note) && (
                <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">
                  {[c.issuer, c.date, c.note].filter(Boolean).join(' · ')}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Publications & Patents -->
  {
    publications.length > 0 && (
      <section class="mt-16">
        <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
          <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true" />
          Publications &amp; Patents
        </h2>
        <ul class="mt-8 space-y-6">
          {publications.map((pub) => (
            <li class="grid gap-1 sm:grid-cols-[6rem_1fr] sm:gap-6">
              <p class="text-sm text-zinc-400">{pub.type}</p>
              <div>
                <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">
                  {pub.link ? (
                    <a href={pub.link} target="_blank" rel="noopener" class="hover:text-accent-600 dark:hover:text-accent-400">
                      {pub.title} ↗
                    </a>
                  ) : (
                    pub.title
                  )}
                </p>
                {pub.venue && <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{pub.venue}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Honors & Awards -->
  {
    resume.honors.length > 0 && (
      <section class="mt-16">
        <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
          <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true" />
          Honors &amp; Awards
        </h2>
        <ul class="mt-8 space-y-2">
          {resume.honors.map((h) => (
            <li class="flex gap-3 text-sm text-zinc-700 dark:text-zinc-300">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-500" aria-hidden="true" />
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Education -->
  <section class="mt-16">
    <h2 class="flex items-center gap-3 text-xs font-semibold uppercase tracking-widest text-zinc-400">
      <span class="h-px w-6 bg-gradient-to-r from-accent-500 to-transparent" aria-hidden="true"></span>
      Education
    </h2>
    <ul class="mt-8 space-y-4">
      {
        resume.education.map((e) => (
          <li class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="text-sm text-zinc-400">{e.period}</p>
            <p class="text-sm text-zinc-700 dark:text-zinc-300">
              <span class="font-medium text-zinc-900 dark:text-zinc-100">{e.title}</span> ·{' '}
              {e.link ? (
                <a href={e.link} target="_blank" rel="noopener" class="text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
                  {e.org} ↗
                </a>
              ) : (
                e.org
              )}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Contact -->
  <section class="mt-16 rounded-2xl border border-zinc-200 bg-gradient-to-br from-zinc-50 to-white p-8 dark:border-zinc-800 dark:from-zinc-900/50 dark:to-zinc-950">
    <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Get in touch</h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      Interested in security, infrastructure, or a possible collaboration? I’m always happy to connect.
    </p>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href={links.email} class="font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
        {links.email.replace('mailto:', '')}
      </a>
      <a href={links.linkedin} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">LinkedIn ↗</a>
      <a href={links.github} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">GitHub ↗</a>
      <a href={links.personal} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">Notes ↗</a>
    </div>
  </section>
</BaseLayout>
