---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, links, resume } from '../config';

// Featured projects for the "Selected work" section (most recent first).
const featured = (await getCollection('projects'))
  .filter((p) => !p.data.draft && p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const publications = resume.publications ?? [];
---
<BaseLayout>
  <!-- Hero -->
  <section class="py-6">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400">{resume.role}</p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
      {site.name}
      <span class="ml-1 text-2xl font-normal text-zinc-400 dark:text-zinc-600 sm:text-3xl">{site.nameKo}</span>
    </h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      {site.tagline}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-zinc-500 dark:text-zinc-400">
      <span class="inline-flex items-center gap-1.5">
        <span class="h-1.5 w-1.5 rounded-full bg-accent-500" aria-hidden="true"></span>
        {resume.location}
      </span>
      <span class="text-zinc-300 dark:text-zinc-700" aria-hidden="true">·</span>
      <span>{resume.available}</span>
    </div>

    <div class="no-print mt-8 flex flex-wrap gap-3">
      <a href={links.email} class="inline-flex items-center rounded-md bg-accent-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-700">
        Get in touch
      </a>
      <a href={links.github} target="_blank" rel="me noopener" class="inline-flex items-center rounded-md border border-zinc-200 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900">
        GitHub ↗
      </a>
      <a href={links.linkedin} target="_blank" rel="me noopener" class="inline-flex items-center rounded-md border border-zinc-200 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900">
        LinkedIn ↗
      </a>
    </div>
  </section>

  <!-- Summary -->
  <section class="mt-16">
    <p class="max-w-2xl text-lg leading-relaxed text-zinc-700 dark:text-zinc-300">
      {resume.summary}
    </p>
  </section>

  <!-- Experience -->
  <section class="mt-16">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Experience</h2>
    <ol class="mt-8 space-y-10">
      {
        resume.experience.map((job) => (
          <li class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <div class="text-sm text-zinc-400">
              <p>{job.period}</p>
              {job.location && <p class="mt-0.5 text-xs">{job.location}</p>}
            </div>
            <div>
              <h3 class="font-medium text-zinc-900 dark:text-zinc-100">
                {job.role} <span class="text-zinc-400">· {job.org}</span>
              </h3>
              <ul class="mt-2 list-disc space-y-1.5 pl-4 text-sm leading-relaxed text-zinc-600 marker:text-accent-500 dark:text-zinc-400">
                {job.points.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- Selected work -->
  {
    featured.length > 0 && (
      <section class="mt-16">
        <div class="flex items-baseline justify-between">
          <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Selected work</h2>
          <a href="/projects/" class="text-sm text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
            All projects →
          </a>
        </div>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {featured.map((p) => (
            <ProjectCard
              title={p.data.title}
              description={p.data.description}
              tags={p.data.tags}
              date={p.data.date}
              href={`/projects/${p.id}/`}
            />
          ))}
        </div>
      </section>
    )
  }

  <!-- Skills -->
  <section class="mt-16">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Skills</h2>
    <dl class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        resume.skills.map((s) => (
          <div>
            <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{s.group}</dt>
            <dd class="mt-2 flex flex-wrap gap-2">
              {s.items.map((item) => (
                <span class="rounded-full border border-zinc-200 px-3 py-1 text-sm text-zinc-600 dark:border-zinc-800 dark:text-zinc-400">
                  {item}
                </span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <!-- Languages & Certifications -->
  <section class="mt-16 grid gap-10 sm:grid-cols-2">
    <div>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Languages</h2>
      <dl class="mt-8 space-y-3">
        {
          resume.languages.map((l) => (
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{l.name}</dt>
              <dd class="text-sm text-zinc-500 dark:text-zinc-400">{l.level}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div>
      <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Certifications</h2>
      <ul class="mt-8 space-y-4">
        {
          resume.certifications.map((c) => (
            <li>
              <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">{c.name}</p>
              {(c.issuer || c.date || c.note) && (
                <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">
                  {[c.issuer, c.date, c.note].filter(Boolean).join(' · ')}
                </p>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Publications & Patents (only when populated) -->
  {
    publications.length > 0 && (
      <section class="mt-16">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Publications &amp; Patents</h2>
        <ul class="mt-8 space-y-6">
          {publications.map((pub) => (
            <li class="grid gap-1 sm:grid-cols-[6rem_1fr] sm:gap-6">
              <p class="text-sm text-zinc-400">{pub.type}</p>
              <div>
                <p class="text-sm font-medium text-zinc-900 dark:text-zinc-100">
                  {pub.link ? (
                    <a href={pub.link} target="_blank" rel="noopener" class="hover:text-accent-600 dark:hover:text-accent-400">
                      {pub.title} ↗
                    </a>
                  ) : (
                    pub.title
                  )}
                </p>
                {pub.venue && <p class="mt-0.5 text-sm text-zinc-500 dark:text-zinc-400">{pub.venue}</p>}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Honors & Awards -->
  {
    resume.honors.length > 0 && (
      <section class="mt-16">
        <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Honors &amp; Awards</h2>
        <ul class="mt-8 space-y-2">
          {resume.honors.map((h) => (
            <li class="flex gap-3 text-sm text-zinc-700 dark:text-zinc-300">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-accent-500" aria-hidden="true" />
              <span>{h}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <!-- Education -->
  <section class="mt-16">
    <h2 class="text-xs font-semibold uppercase tracking-widest text-zinc-400">Education</h2>
    <ul class="mt-8 space-y-4">
      {
        resume.education.map((e) => (
          <li class="grid gap-2 sm:grid-cols-[9rem_1fr] sm:gap-6">
            <p class="text-sm text-zinc-400">{e.period}</p>
            <p class="text-sm text-zinc-700 dark:text-zinc-300">
              <span class="font-medium text-zinc-900 dark:text-zinc-100">{e.title}</span> · {e.org}
            </p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Contact -->
  <section class="mt-16 rounded-2xl border border-zinc-200 p-8 dark:border-zinc-800">
    <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Get in touch</h2>
    <p class="mt-2 max-w-xl text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
      Interested in security, infrastructure, or a possible collaboration? I’m always happy to connect.
    </p>
    <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href={links.email} class="font-medium text-accent-600 transition-colors hover:text-accent-700 dark:text-accent-400">
        {links.email.replace('mailto:', '')}
      </a>
      <a href={links.linkedin} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">LinkedIn ↗</a>
      <a href={links.github} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">GitHub ↗</a>
      <a href={links.personal} target="_blank" rel="me noopener" class="text-zinc-500 transition-colors hover:text-zinc-900 dark:hover:text-zinc-100">Notes ↗</a>
    </div>
  </section>
</BaseLayout>
