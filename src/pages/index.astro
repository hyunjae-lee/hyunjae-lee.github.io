---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, links } from '../config';
---
<BaseLayout>
  <section class="py-8">
    <p class="text-sm font-medium text-accent-600 dark:text-accent-400">
      정보보안 · 인프라 엔지니어
    </p>
    <h1 class="mt-3 text-4xl font-bold tracking-tight text-zinc-900 sm:text-5xl dark:text-zinc-100">
      {site.name}
      <span class="block text-zinc-400 dark:text-zinc-600">{site.nameKo}</span>
    </h1>

    <p class="mt-6 max-w-xl text-lg leading-relaxed text-zinc-600 dark:text-zinc-400">
      {site.tagline}
    </p>
    <p class="mt-1 max-w-xl text-sm text-zinc-400 dark:text-zinc-500">
      {site.taglineEn}
    </p>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <a
        href="/projects/"
        class="inline-flex items-center rounded-md bg-accent-600 px-4 py-2 text-sm font-medium text-white transition-colors hover:bg-accent-700"
      >
        프로젝트 보기
      </a>
      <a
        href="/about/"
        class="inline-flex items-center rounded-md border border-zinc-200 px-4 py-2 text-sm font-medium text-zinc-700 transition-colors hover:bg-zinc-100 dark:border-zinc-800 dark:text-zinc-300 dark:hover:bg-zinc-900"
      >
        소개 →
      </a>
    </div>

    <div class="mt-12 flex flex-wrap gap-x-6 gap-y-2 text-sm">
      <a href={links.github} class="text-zinc-500 transition-colors hover:text-accent-600 dark:hover:text-accent-400" target="_blank" rel="me noopener">GitHub ↗</a>
      <a href={links.linkedin} class="text-zinc-500 transition-colors hover:text-accent-600 dark:hover:text-accent-400" target="_blank" rel="me noopener">LinkedIn ↗</a>
      <a href={links.email} class="text-zinc-500 transition-colors hover:text-accent-600 dark:hover:text-accent-400">Email ↗</a>
    </div>
  </section>
</BaseLayout>
