---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ImageDialog from '../components/ImageDialog.astro';
import { site, links, resume } from '../config';
import { t, type Lang } from '../i18n';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: Lang;
}

const { title, description, lang = 'en' } = Astro.props;
const r = resume[lang];
const pageTitle = title ? `${title} — ${site.name}` : r.title;
const desc = description ?? r.tagline;

// Localized alternates (en at root, ko under /ko/).
const path = Astro.url.pathname;
const enPath = path.replace(/^\/ko(?=\/|$)/, '') || '/';
const koPath = enPath === '/' ? '/ko/' : `/ko${enPath}`;
const selfPath = lang === 'ko' ? koPath : enPath;
const canonical = new URL(selfPath, site.url).href;
const enHref = new URL(enPath, site.url).href;
const koHref = new URL(koPath, site.url).href;
// Blog posts are single-language, so they get no hreflang alternates.
const hasAlternate = !/^\/blog\/[^/]+/.test(enPath);
const ogImage = new URL('/og.png', site.url).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  alternateName: site.nameKo,
  jobTitle: r.role,
  url: site.url,
  email: links.email.replace('mailto:', ''),
  address: { '@type': 'PostalAddress', addressLocality: r.location },
  sameAs: [links.github, links.linkedin],
};
---
<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Color scheme: "light dark" follows the OS; a stored override pins "light" or "dark".
         This tiny inline script only exists to avoid a flash of the wrong scheme. -->
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      try {
        document.querySelector('meta[name="color-scheme"]').content = localStorage.getItem('color-scheme') ?? 'light dark';
      } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#09090b" media="(prefers-color-scheme: dark)" />

    <title>{pageTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    {hasAlternate && <link rel="alternate" hreflang="en" href={enHref} />}
    {hasAlternate && <link rel="alternate" hreflang="ko" href={koHref} />}
    {hasAlternate && <link rel="alternate" hreflang="x-default" href={enHref} />}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'ko' ? 'ko_KR' : 'en_US'} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />

    <!-- Speculative loading (modern-web-guidance: improve-next-page-load-performance):
         prefetch same-origin pages on hover/press; never the PDF downloads. -->
    <script type="speculationrules" is:inline>
      {
        "prefetch": [{
          "where": { "and": [
            { "href_matches": "/*" },
            { "not": { "href_matches": "/resume/*" } },
            { "not": { "href_matches": "/*.pdf" } }
          ] },
          "eagerness": "moderate"
        }]
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent-600 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-white"
    >
      {t(lang, 'a11y.skip')}
    </a>
    <Header lang={lang} />
    <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
      <slot />
    </main>
    <Footer lang={lang} />
    <ImageDialog lang={lang} />
  </body>
</html>
